#!/usr/bin/env python3
import json
import os
import re
import subprocess
import sys
import urllib.parse

arg = sys.argv[1] if len(sys.argv) > 1 else ""

def strip_scheme(s):
    for prefix in (
        "file://localhost.localdomain/",
        "file://localhost/",
        "emacs:///",
        "file:///",
        "emacs://",
        "file://",
    ):
        if s.startswith(prefix):
            return "/" + s[len(prefix):]

    if s.startswith("emacs:"):
        return s[6:]

    if s.startswith("file:"):
        return s[5:]

    return s

path = urllib.parse.unquote(strip_scheme(arg)).rstrip(":")

line = 1
col = 1

m = re.match(r"^(.+):([0-9]+):([0-9]+)$", path)
if m:
    path, line, col = m.group(1), int(m.group(2)), int(m.group(3))
else:
    m = re.match(r"^(.+):([0-9]+)$", path)
    if m:
        path, line = m.group(1), int(m.group(2))

elisp = f'''
(progn
  (select-frame-set-input-focus (selected-frame))
  (find-file {json.dumps(path)})
  (goto-char (point-min))
  (forward-line {max(line - 1, 0)})
  (move-to-column {max(col - 1, 0)})
  (recenter)
  t)
'''

sys.exit(subprocess.call([
    "emacsclient",
    "-n",
    "-e",
    elisp
]))

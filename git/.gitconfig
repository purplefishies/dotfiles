# Linux global ~/.gitconfig
# Load common behavior, then Linux defaults, then identity overrides by repo path.
# Later includes override earlier settings, so .gitconfig.work can choose Meld
# for GALT repos while Linux defaults remain BCompare.

[include]
    path = ~/.gitconfig.common
    path = ~/.gitconfig.linux

# Personal repos
[includeIf "gitdir:~/Templates/**"]
    path = ~/.gitconfig.personal

[includeIf "gitdir:~/Dropbox/**"]
    path = ~/.gitconfig.personal

[includeIf "gitdir:~/Scripts/**"]
    path = ~/.gitconfig.personal

[includeIf "gitdir:~/Projects/**"]
    path = ~/.gitconfig.personal

[includeIf "gitdir:~/Projects/galt_*/**"]
    path = ~/.gitconfig.work

[includeIf "gitdir:~/Projects/dotfiles/.git"]
    path = ~/.config/git/dotfiles.gitconfig

[includeIf "gitdir:~/Projects/dotfiles/**"]
    path = ~/.config/git/dotfiles.gitconfig


[includeIf "gitdir:~/.config/**"]
    path = ~/.gitconfig.personal

# Current job / GALT SW repos.
# Put GALT repos under one of these directories, or edit/add patterns here.
[includeIf "gitdir:~/work/galt/**"]
    path = ~/.gitconfig.work

[includeIf "gitdir:~/Projects/GALT/**"]
    path = ~/.gitconfig.work

[includeIf "gitdir:~/Projects/galt/**"]
    path = ~/.gitconfig.work

# Older BotsU work repos. These are after ~/Projects/** so they override personal.
[includeIf "gitdir:~/Projects/BotsU/**"]
    path = ~/.gitconfig.botsu

[includeIf "gitdir:~/Projects/sparrow_bots/**"]
    path = ~/.gitconfig.botsu
[safe]
	directory = /home/jdamon/Projects/gnuradio
